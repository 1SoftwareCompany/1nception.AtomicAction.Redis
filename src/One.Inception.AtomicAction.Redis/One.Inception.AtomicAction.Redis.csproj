<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0</TargetFrameworks>

  </PropertyGroup>

  <!--Nuget-->
  <PropertyGroup>
    <PackageId>1nception.AtomicAction.Redis</PackageId>

    <Copyright>Copyright © 1Software</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RequireLicenseAcceptance>true</RequireLicenseAcceptance>

    <RepositoryUrl>https://github.com/1SoftwareCompany/1nception.git</RepositoryUrl>
    <PackageProjectUrl>https://github.com/1SoftwareCompany/1nception</PackageProjectUrl>
    <RepositoryType>git</RepositoryType>

    <AssemblyName>One.Inception.AtomicAction.Redis</AssemblyName>
    <RootNamespace>One.Inception.AtomicAction.Redis</RootNamespace>
    <NeutralLanguage>en-US</NeutralLanguage>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AssemblyVersion>13.0.0.0</AssemblyVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="1nception" Version="14.0.0" />

    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="11.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="11.0.0" />
    <PackageReference Include="One.AtomicAction" Version="2.0.11" />
    <PackageReference Include="StackExchange.Redis" Version="3.4.35" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="One.Inception.AtomicAction.Redis.Integration.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="Microsoft.SourceLink.GitHub" Version="11.0.100" />
  </ItemGroup>
</Project>
